#!/usr/local/bin/tclsh9.0

# NewsHub - Aggregate, store and supply news data from multiple sources.

source config.tcl
source retcl-0.7.1.tm
source distcl.tcl
package require mime

package require retcl
retcl create redis

package require sqlite3
sqlite3 overdb $over_db -fullmutex 1
overdb timeout 20000
sqlite3 archdb $arch_db
archdb timeout 60000

# various periods in seconds
set fivemin 300
set hour 3600
set day 86400
set week 604800
set days30 2592000
set year [expr {$day*365}]

# articles before this date will be in archdb
set arch_max_dat [clock scan {1/1/2004}]

# articles before this date will be in blueworld, after in E-S
set hist_max_dat [clock scan {1/1/2025}]

set news_epoch [clock scan {1/1/1980}]
set postbatch 500
set max_search_secs 5

# a little debugging helper
proc printvars args {
    set now [clock microseconds]
    set elapsed [expr {$::printvars_time ? $now - $::printvars_time : 0}]
    set ::printvars_time $now
    puts -nonewline "[format %8d $elapsed] "
    
    foreach var $args {
        upvar $var pv[incr n]
	if {[info exists pv$n]} {
            puts -nonewline "$var='[set pv$n]' "
        } else {
            puts -nonewline "$var: "
        }
    }
    puts {}
}
set printvars_time 0

proc convertit txt {
    if {[catch {encoding convertto $txt} res]} {
        #TODO Fix better?
        return "ENCODING CONVERSION ERROR"
    }
    return $res
}

proc execute {func args} {
    lassign $args arg1 arg2
    switch $func {
        art {
            set art [get_art $arg1 $arg2]
	    return -secs2keep $::week $art
        }
        mid {
            set art [get_mid $arg1]
	    return -secs2keep $::week $art
        }
        grup {
	    return -secs2keep 5 [group_updater $arg1 0]
        }
        counts {
	    return -secs2keep 30 [group_counts $arg1]
        }
        findall {
	    return -secs2keep $::fivemin [find_all {*}$args]
        }
        face {
            if {[string length $arg1] > 4096} {error "X-Face data too long"}
            set conversion [open "| uncompface -X | xbmtopbm | pnmtopng" wb+]
            puts -nonewline $conversion $arg1
            close $conversion write
            set png [read $conversion]
            close $conversion
            return -secs2keep $::days30 $png
        }
        charter {
	    return -secs2keep $::days30 [get_charter $arg1]
        }
        testy {
	    #after 10000
	    return "testified $arg1"
        }
        daily {
	    return -secs2keep $::day [age_groupreads]
        }
        default {
            error "UNRECOGNISED REQUEST: '$func'"
        }
    }
}

#############################################################################
# Update group info in db tables "groups"&"over"
# For a 'grup' request this code is run directly with coro=0.
# For a 'counts' request this code is run in a coroutine for each group
# the user is subscribed to, with coro=1.
# The server communications are done in parallel, but the subsequent
# database updates are all done together in a single transaction.
proc group_updater {group coro} {
#printvars group_updater group
    if {$coro} yield
    set select {SELECT rowid,servers FROM groups WHERE name == $group}
    lassign [overdb eval $select] grpid servers
    if {$grpid eq {}} return
    # Hack to spread the load:
    if {[regexp {^(alt|comp|news)\.} $group]} {set servers [linsert $servers 0 np]}

    set failed 1
    foreach server $servers {

        set old_last [overdb eval {SELECT last FROM counts WHERE grpid==$grpid AND server==$server}]
        if {! [string is integer -strict $old_last]} {set old_last 0}
        if {$coro} {
            distcl::prefetch redis $server new $group $old_last
            yield pre
        }
#printvars group_updater2 group

        set limit 0
        set failed [catch {distcl::get redis $server new $group $old_last} newer]
        if {! $failed} {
            lassign $newer limit last xover
            break
        }
    }
    if {! $failed && $last > $old_last} {
        if [catch {

            if {$limit} {
                # too far out-of-date, need to catchup
                set xover [do_catchup $group $grpid $server $limit $xover]
            }
            if {$coro} {yield db}

#printvars group_updater3 group
            overdb eval {UPDATE counts SET last=$last WHERE grpid==$grpid AND server==$server}
            if {! [overdb changes]} {
                overdb eval {INSERT INTO counts(grpid,server,last) VALUES($grpid,$server,$last)}
            }
            group_store $group $xover
        } err] {puts "group_updater $group $coro FAILED '$err'"; return}
    }
    if {! $coro} return

    set lastdat [yield post]

    return [overdb eval {SELECT count(*) FROM over WHERE grpid==$grpid AND dat>$lastdat}]
}
#############################################################################
# Return the list of groups the user has previously read.
# For each group returns name, number of new posts since last 
# read by this user & whether any of those is a reply to a post
# by this user.
proc group_counts user {
    set ugrps [redis -sync hgetall "ugrp $user"]
    if {$ugrps eq {}} return

    set pre_groups {}
    set db_groups {}
    set post_groups [dict create]

    # Create a coroutine to do the updating for each group
    foreach {group ugrp} $ugrps {
        coroutine update_$group group_updater $group 1
        lappend pre_groups $group
    }
    # Each coroutine will yield 'pre' when it has issued a prefetch,
    # 'db' when it is ready to update the database,
    # or 'post' if it is skipping the db update.
    # Returning nothing means it cannot continue.
    # We iterate over the group_updaters until all have left 'pre' state.
    while {[llength $pre_groups]} {
        set group [lpop pre_groups 0]
        set state [update_$group]
	switch $state {
	    pre {lappend pre_groups $group}
	    db {lappend db_groups $group}
	    post {dict set post_groups $group 1}
	}
    }
        
    # add new header info to database
    overdb transaction {
        foreach group $db_groups {
            update_$group
	    dict set post_groups $group 1
        }
    }
    # urep for each user maps groups to the article number of the latest
    # reply in that group to a post by this user. The urep values are
    # updated while adding new posts to the database.
    set ureps [redis -sync hgetall "urep $user"]
#printvars ureps

    # count new posts in each group
    set result {}
    foreach {group ugrp} $ugrps {
        if {! [dict exists $post_groups $group]} continue
        # The ugrp record may also contain a new value
        # which should now replace the old one:
        lassign $ugrp old_last new_last
        if {$new_last ne {}} {
            lappend ugrp_updates $group $new_last
#printvars ugrp_updates
            set old_last $new_last
        }
        set new_posts [update_$group $old_last]

#printvars group
        set latest_reply [dict getdef $ureps $group 0]
#printvars latest_reply
        set new_reply [expr {$latest_reply > $old_last}]

        lappend result $group $new_posts $new_reply
    }
#printvars ugrp_updates
    if {[info exists ugrp_updates]} {
        redis -sync hset "ugrp $user" {*}$ugrp_updates
    }
    return $result
}
#############################################################################

proc group_store {group xover} {

    set parsed [lmap hdr $xover {parse_over $hdr}]

#printvars group_store group
    set user_replies {}
    append reply_re {^\d+-(\d+)@} $::this_site $

    overdb transaction {
        set select {SELECT rowid FROM groups WHERE name == $group}
        lassign [overdb eval $select] grpid

        foreach over $parsed {
            lassign $over sub from dat msgid prev grps
	    set xgrpids {}
            foreach grp $grps {
                if {$grp eq $group} continue
                if {! [info exists ::grpids($grp)]} continue
                lappend xgrpids $::grpids($grp)
            }
#printvars xgrpids
            # Ensure grpid+dat is unique
            set select {SELECT count(*) FROM over WHERE grpid==$grpid AND dat==$dat}
            while {[overdb eval $select]} {incr dat}

            overdb eval {INSERT INTO over(grpid,sub,frm,dat,msgid,prev,xgrpids)
                         VALUES($grpid,$sub,$from,$dat,$msgid,$prev,$xgrpids)
                         ON CONFLICT DO NOTHING}
            if {[overdb changes]} {
                if {[regexp $reply_re $prev - user]} {
                    lappend user_replies $user $dat
                }
            }
        }
    }
#printvars user_replies
    # Record the most recent replies to posts by our own users in this group
    foreach {user num} $user_replies {
        redis -sync hset "urep $user" $group $num
    }
}

set tzmap {
	{Pacific Standard Time} PST
	{Pacific Daylight Time} PDT
	{Eastern Daylight Time} EDT
	{Eastern Standard Time} EST
	{Central (US)} CST
	PAC PST
	BRT BT
	MESZ CEST
	LOCAL {}
	ET EST
	{ et} { EST}
	{ ct} { CST}
	{-EDT} { EDT}
}

# Extract article info from one XOVER line.
proc parse_over hdr {
    lassign [split $hdr \t] num sub from date msgid refs sz1 sz2 xref

    catch {set sub [::mime::field_decode $sub]}
    catch {set from [::mime::field_decode $from]}
    set msgid [string trim $msgid <>]
    set reflist [regexp -all -inline {<[[:graph:]]+@[[:graph:]]+>} $refs]
    set prev [lindex $reflist end]
    set prev [string trim $prev <>]

    #printvars sub from date msgid refs xref
    set grpre {([[:alnum:]_\-\+]+\.[[:alnum:]_\.\-\+]+):\d+}
    set grplist [regexp -all -inline $grpre $xref]
    #printvars grplist
    set grps {}
    foreach {_ grp} $grplist {
        lappend grps $grp
    }

    # hacks for weird date formats
    set date [regsub {^Date: } $date {}]
    set date [regsub {^[[:alpha:]_.]{3,},} $date {}]
    set date [regsub {\m(\d\d\d\d)/(\d\d)/(\d\d)\M} $date {\2/\3/\1}]
    set date [regsub {\m(\d\d)\.(\d\d)\.(\d\d)\M} $date {\1:\2:\3}]
    set date [regsub {\m(\d\d): (\d):(\d\d)\M} $date {\1:0\2:\3}]
    set date [regsub {\mGMT(.\d+)\M} $date {\1}]
    set date [string map $::tzmap $date]
    if {[catch {clock scan $date -validate 0} dat]} {
        #try stripping off an unrecognised timezone
        set date [regsub {\m(\d\d:\d\d:\d\d)\s.*$} $date {\1}]
        set date [regsub {\m(\d\d:\d\d)\s+[[:alpha:]/]+$} $date {\1}]
        #remove extra space before minutes
        set date [regsub {\m(\d\d): (\d\d:\d\d)\s.*$} $date {\1:\2}]
        if {[catch {clock scan $date -validate 0} dat]} {
	    set dat [clock seconds] ;# if all else fails, use "now".
	}
    }

    return [list $sub $from $dat $msgid $prev $grps]
}

proc do_catchup {group grpid server limit xover} {
#printvars do_catchup group grpid server
    set select {SELECT count(*) FROM over WHERE grpid==$grpid AND msgid==$msgid}
    set matched 0
    set all_xover {}
    while 1 {
#printvars do_catchup limit
        foreach hdr [lreverse $xover] {
            lassign [split $hdr \t] num sub from date msgid refs sz1 sz2 xref
            set msgid [string trim $msgid <>]
            if {[overdb eval $select]} {
                if {[incr matched] > 10} {
#printvars do_catchup matched [llength $all_xover]
                    return [lreverse $all_xover]
                }
            } else {
                lappend all_xover $hdr
            }
        }
        if {$limit == 0} break
        lassign [distcl::get redis $server backfill $group $limit] limit xover

    }
    return [lreverse $all_xover]
}

proc get_art {group dat} {
    set select {SELECT rowid,servers FROM groups WHERE name == $group}
    lassign [overdb eval $select] grpid servers
#printvars group num grpid servers 
    overdb eval {SELECT msgid FROM over WHERE grpid==$grpid AND dat==$dat} {
#printvars msgid dat
        if {$dat < $::arch_max_dat} {
            archdb eval {SELECT txt FROM arts WHERE msgid==$msgid} {
                    return [convertit $txt]
            }
        }
        if {! [catch {distcl::get redis np mid <$msgid>} art]} {
            return [join $art \n]
        }
        if {$dat > $::hist_max_dat && "ng" in $servers} {
            if {! [catch {distcl::get redis ng mid <$msgid>} art]} {
                return [join $art \n]
            }
        }
        if {$dat > $::arch_max_dat && "na" in $servers} {
            if {! [catch {distcl::get redis na mid <$msgid>} art]} {
                return [join $art \n]
            }
        }
        archdb eval {SELECT txt FROM arts WHERE msgid==$msgid} {
                    return [convertit $txt]
        }
    }
    error "Article not found"
}

proc get_mid msgid {
    set mid [string trim $msgid <>]
    archdb eval {SELECT txt FROM arts WHERE msgid==$mid} {
        return [convertit $txt]
    }
    foreach server {np ng na} {
        if {! [catch {distcl::get redis $server mid $msgid} art]} {
            return [join $art \n]
        }
    }
    error "Article not found"
}

overdb eval {SELECT name,rowid FROM groups} {
    set grpids($name) $rowid
}

#############################################################################

# Search across all the user's groups for articles with matching
# subject, author, before the given time.
proc find_all {user sub frm tim} {
    set starttime [clock seconds]
    set ugrps [redis -sync hgetall "ugrp $user"]
    set grpids {}
    foreach {group ugrp} $ugrps {
        if {! [info exists ::grpids($group)]} continue
        lappend grpids $::grpids($group)
    }
    set grplst [join [lsort -integer $grpids] ,]
    set sql_where "grpid IN ($grplst) "

    set sql {SELECT grpid,sub,frm,dat,msgid,xgrpids FROM over }
    append sql "WHERE grpid IN ($grplst) "
    if {$sub ne {}} {set sub %$sub%; append sql {AND sub LIKE $sub }}
    if {$frm ne {}} {set frm %$frm%; append sql {AND frm LIKE $frm }}
    if {$tim eq {}} {set tim [clock seconds]}
    append sql {AND dat <= $tim AND dat > $earliest }
    append sql {ORDER BY dat DESC}
    append sql " LIMIT $::postbatch"
    set hdrs {}

    while {$tim > $::news_epoch} {
        set earliest [expr {$tim - $::year}]

        overdb eval $sql {
            set sub [convertit $sub]
            set frm [convertit $frm]
            lappend hdrs [list $grpid $sub $frm $dat $msgid $xgrpids]
        }
        set nexttim [expr {[llength $hdrs] ? [lindex $hdrs end 3] : $earliest}]
        if {[llength $hdrs] >= $::postbatch
          || [clock seconds] - $starttime >= $::max_search_secs} {
            return [list $nexttim $hdrs]
        }
	set tim $earliest
    }
    return [list 0 $hdrs]
}

#############################################################################

proc get_charter group {

    set hier [group_hier $group]
    set url "https://ftp.isc.org/usenet/control/$hier/$group.gz"
    set ctlmsgs [open "| wget -q --timeout=15 --tries=1 -O - $url | gunzip"]
    fconfigure $ctlmsgs -translation binary

    while 1 {
        if {[gets $ctlmsgs line] < 0} {
            catch {close $ctlmsgs}
            return {}
        }
        if {[string trim $line] eq "For your newsgroups file:"} break
    }
    gets $ctlmsgs
    gets $ctlmsgs last
    set charter {}
    while {[gets $ctlmsgs line] >= 0} {
        if {$line eq "-- "} break
        if {[string range $line 0 4] eq "From " && $last eq ""} break
        append charter $line "\n"
        set last $line
    }
    catch {close $ctlmsgs}
    return [string trim $charter]
}

# Check group is valid and return top-level hierarchy
proc group_hier group {
    set group_re {^[[:alnum:]_\-\+]+\.[[:alnum:]_\.\-\+]+$}
    if {[regexp $group_re $group]} {
        return [lindex [split $group .] 0]
    }
    error "Invalid group '$group'"
}

#############################################################################
# Each day we fade the group read counts by 0.9 to get decaying averages
proc age_groupreads {} {
    set age_count 0
    set rem_count 0
    foreach {group reads} [redis -sync zrange groupreads 0 -1 withscores] {
        set new_score [expr {$reads * 9 / 10}]
        #printvars group reads new_score
	if {$new_score > 0} {
            redis -sync zadd groupreads $new_score $group
            incr age_count
	} else {
            redis -sync zrem groupreads $group
            incr rem_count
	}
    }
    #puts "Aged read counts for $age_count groups, removed $rem_count."
    #after [expr {$::day * 1000}] age_groupreads
    return [list $age_count $rem_count]
}

#############################################################################

distcl::serve redis nh execute

