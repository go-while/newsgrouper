#!/usr/local/bin/tclsh9.0

# One-time script to update users' article counts from sequential to timestamp basis

source nu_config.tcl
source retcl.tm

package require retcl
retcl create redis

package require sqlite3
sqlite3 overdb $over_db -fullmutex 1
overdb timeout 20000

# articles before this date don't exist
set net_min_dat [clock scan {1/1/1980}]

# a little debugging helper
proc printvars args {
    set now [clock microseconds]
    set elapsed [expr {$now - $::printvars_time}]
    set ::printvars_time $now
    puts -nonewline "[format %8d $elapsed] "
    
    foreach var $args {
        upvar $var pv[incr n]
	if {[info exists pv$n]} {
            puts -nonewline "$var='[set pv$n]' "
        } else {
            puts -nonewline "$var: "
        }
    }
    puts {}
}
set printvars_time [clock microseconds]

set ugrps [redis -sync keys "ugrp *"]
#set ugrps {{ugrp 7}}
foreach ugrp $ugrps {
    set grpcounts [redis -sync hgetall $ugrp]
    foreach {group count} $grpcounts {
        #puts "$ugrp : $group $count"
        
        set num [lindex $count end]
        if {$num < $::net_min_dat} {
            # convert from article number to timestamp
            set grpid [overdb eval {SELECT rowid FROM groups WHERE name == $group}]
            set lastdat [overdb eval {SELECT dat FROM over WHERE grpid==$grpid AND num==$num}]
            if {$lastdat eq {}} {set lastdat 0}
            puts "redis -sync hset $ugrp $group $lastdat"
            redis -sync hset $ugrp $group $lastdat
#printvars ugrp group grpid num lastdat
        }
    }
}
